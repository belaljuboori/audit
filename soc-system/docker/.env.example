# Copy to docker/.env and fill in real values. Never commit the real .env.
# Generate secrets with: openssl rand -hex 32 / openssl rand -base64 48

APP_URL=https://soc.bank.local

MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
SOC_APP_DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD
SOC_MIGRATOR_DB_PASSWORD=CHANGE_ME_MIGRATOR_DB_PASSWORD

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

JWT_ACCESS_SECRET=CHANGE_ME_64_BYTE_RANDOM_STRING
MASTER_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY

# Bootstrap Super Admin identity (password is generated and printed once by
# the seed script — it is intentionally NOT an env var here).
SEED_SUPER_ADMIN_USERNAME=admin
SEED_SUPER_ADMIN_EMAIL=admin@bank.local

# Only needed if phpMyAdmin is served behind a path/subdomain reverse proxy.
PMA_ABSOLUTE_URI=

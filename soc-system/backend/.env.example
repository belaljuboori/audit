# ── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://soc.bank.local

# ── Database (MariaDB). Never use the root account here — use the
#    least-privilege soc_app account created by docker/mariadb/init/01-app-user.sql ──
DATABASE_URL="mysql://soc_app:CHANGE_ME@mariadb:3306/soc_live_monitoring"

# ── Redis (BullMQ broker + cache, wired up starting Phase 2) ────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_64_BYTES_RANDOM
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
REFRESH_COOKIE_NAME=soc_refresh_token

# ── Master encryption key for AES-256-GCM (node credentials, secrets at rest).
#    Generate with: openssl rand -hex 32   (must decode to exactly 32 bytes) ──
MASTER_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY

# ── Account lockout / rate limiting ──────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=20
# Separate, stricter throttle just for /auth/login (anti brute-force)
AUTH_LOGIN_THROTTLE_LIMIT=10
AUTH_LOGIN_THROTTLE_TTL_SECONDS=60

# ── CORS allow-list (comma-separated, no wildcards in production) ───────────
CORS_ALLOWED_ORIGINS=https://soc.bank.local

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Demo mode — MUST be false in any environment touching real data ─────────
DEMO_MODE=false
